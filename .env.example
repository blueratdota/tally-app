# Copy to .env (which git ignores) and fill in. Never commit .env.
# Leave SHEET_ID empty to run with in-memory test data instead.

APP_PASSCODE=

# From the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=
# From the service account JSON key: "client_email" and "private_key".
# Keep the private key on one line in double quotes, \n sequences as-is.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: only needed to upload card logos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
